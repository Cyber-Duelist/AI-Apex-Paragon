---
import { certifications } from '../data/site';
---

<section class="section credentials" id="credentials" data-signal-anchor data-pipeline-stage="4">
  <p class="section-label">05 — Guardrail checkpoint</p>
  <h2 class="section-title section-title--amber">Credentials</h2>
  <p class="dim" style="margin-bottom: 2rem;">Verified certifications — linked to source PDFs.</p>
  <div class="credential-grid">
    {
      certifications.map((cert) => (
        <a class="credential-stamp" href={cert.pdf} target="_blank" rel="noopener noreferrer">
          <svg class="credential-stamp__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="24" cy="24" r="18" />
            <path d="M16 24l5 5 11-12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <p class="credential-stamp__name">{cert.name}</p>
          <p class="credential-stamp__org">{cert.org}</p>
          <p class="credential-stamp__year">{cert.year}</p>
        </a>
      ))
    }
  </div>
</section>
